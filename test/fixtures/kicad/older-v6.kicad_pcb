(kicad_pcb (version 20211014) (generator pcbnew)

  (general
    (thickness 1.6)
  )

  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (40 "Dwgs.User" user "User.Drawings")
    (44 "Edge.Cuts" user)
    (49 "F.Fab" user)
  )

  (setup
    (pad_to_mask_clearance 0)
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "+5V")
  (net 3 "Net-(Q1-Pad3)")
  (net 4 "/sense")

  (footprint "handmade:SOT_like" (layer "F.Cu")
    (tedit 0) (tstamp 00000000-0000-0000-0000-000000000001)
    (at 20 15 30)
    (fp_text reference "Q1" (at 0 -2.5 30) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_text value "BSS_like" (at 0 2.5 30) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_text user "${REFERENCE}" (at 0 0 30) (layer "F.Fab")
      (effects (font (size 0.5 0.5) (thickness 0.08)))
    )
    (fp_line (start -1.2 -0.7) (end 1.2 -0.7) (layer "F.SilkS") (width 0.12))
    (fp_line (start -1.2 0.7) (end 1.2 0.7) (layer "F.SilkS") (width 0.12))
    (mystery_token)
    (pad "1" smd custom (at -0.95 1.1 30) (size 0.6 0.6) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 1 "GND")
      (options (clearance outline) (anchor rect))
      (primitives
        (gr_poly (pts (xy -0.3 -0.3) (xy 0.3 -0.3) (xy 0 0.6)) (width 0) (fill yes))
      )
    )
    (pad "2" smd trapezoid (at 0.95 1.1 30) (size 0.6 0.8) (rect_delta 0 0.2) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 4 "/sense")
    )
    (pad "3" smd rect (at 0 -1.1 30) (size 0.6 0.9) (layers "F.Cu" "F.Paste" "F.Mask")
      (net 3 "Net-(Q1-Pad3)")
    )
    (model "${KICAD6_3DMODEL_DIR}/made_up.wrl"
      (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0))
    )
  )

  (footprint "handmade:R_like" (layer "B.Cu")
    (tedit 0) (tstamp 00000000-0000-0000-0000-000000000002)
    (at 30 15 45)
    (fp_text reference "R5" (at 0 -1.5 45) (layer "B.SilkS")
      (effects (font (size 1 1) (thickness 0.15)) (justify mirror))
    )
    (fp_text value "4k7" (at 0 1.5 45) (layer "B.SilkS") hide
      (effects (font (size 1 1) (thickness 0.15)) (justify mirror))
    )
    (fp_line (start -1.5 -0.6) (end 1.5 -0.6) (layer "B.SilkS") (width 0.12))
    (fp_line (start -1.5 0.6) (end 1.5 0.6) (layer "B.SilkS") (width 0.12))
    (pad "1" smd roundrect (at -1 0.2 225) (size 1 1.2) (layers "B.Cu" "B.Paste" "B.Mask") (roundrect_rratio 0.25)
      (net 3 "Net-(Q1-Pad3)")
    )
    (pad "2" smd rect (at 1.2 0 225) (size 0.8 1.2) (layers "B.Cu" "B.Paste" "B.Mask")
      (net 2 "+5V")
    )
  )

  (footprint "handmade:Header_like" (layer "F.Cu")
    (tedit 0) (tstamp 00000000-0000-0000-0000-000000000003)
    (at 10 24 270)
    (fp_text reference "J2" (at 0 -2 270) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_text value "HDR2" (at 0 4 270) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (pad "1" thru_hole rect (at 0 0 270) (size 1.6 1.6) (drill 0.9) (layers *.Cu *.Mask)
      (net 2 "+5V")
    )
    (pad "2" thru_hole oval (at 0 2.54 270) (size 1.6 2.2) (drill oval 0.9 1.4) (layers *.Cu *.Mask)
      (net 1 "GND")
    )
  )

  (gr_rect (start 0 0) (end 40 30) (layer "Edge.Cuts") (width 0.1) (fill none))
  (gr_circle (center 5 5) (end 6.6 5) (layer "Edge.Cuts") (width 0.1) (fill none))
  (gr_line (start 2 28) (end 12 28) (layer "F.SilkS") (width 0.15))
  (gr_circle (center 35 25) (end 36 25) (layer "F.Fab") (width 0.1) (fill none))
  (gr_text "hand written" (at 20 3) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (dimension (type aligned) (layer "Dwgs.User")
    (pts (xy 0 32) (xy 40 32))
    (height 2)
    (gr_text "40 mm" (at 20 36) (layer "Dwgs.User")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (format (units 2) (units_format 1) (precision 2))
    (style (thickness 0.1) (arrow_length 1.27) (text_position_mode 0) (extension_height 0.58) (extension_offset 0))
  )
  (target plus (at 38 2) (size 2) (width 0.1) (layer "Edge.Cuts"))
  (mystery_token 1)

  (segment (start 10 24) (end 18 24) (width 0.3) (layer "F.Cu") (net 2))
  (segment (start 20 10) (end 30 10) (width 0.2) (layer "In1.Cu") (net 1))
  (arc (start 18 24) (mid 21 22) (end 24 24) (width 0.3) (layer "F.Cu") (net 2))
  (via (at 25 20) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 1))

  (zone (net 1) (net_name "GND") (layers "F.Cu" "B.Cu") (tstamp 00000000-0000-0000-0000-000000000010) (hatch edge 0.508)
    (priority 1)
    (connect_pads (clearance 0.3))
    (min_thickness 0.25) (filled_areas_thickness no)
    (fill yes (thermal_gap 0.4) (thermal_bridge_width 0.35))
    (polygon
      (pts (xy 1 1) (xy 39 1) (xy 39 29) (xy 1 29))
    )
  )
  (zone (net 0) (net_name "") (layer "F.Cu") (tstamp 00000000-0000-0000-0000-000000000011) (hatch edge 0.508)
    (connect_pads (clearance 0))
    (min_thickness 0.254)
    (keepout (tracks not_allowed) (vias allowed) (pads allowed) (copperpour not_allowed) (footprints allowed))
    (fill (thermal_gap 0.508) (thermal_bridge_width 0.508))
    (polygon
      (pts (xy 32 3) (xy 37 3) (xy 37 8) (xy 32 8))
    )
  )
  (zone (net 1) (net_name "GND") (layer "F.Cu") (tstamp 00000000-0000-0000-0000-000000000012) (hatch edge 0.508)
    (priority 30000)
    (attr (teardrop (type padvia)))
    (connect_pads yes (clearance 0))
    (min_thickness 0.0254)
    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon
      (pts (xy 9 23) (xy 11 23) (xy 11 25) (xy 9 25))
    )
  )
)
