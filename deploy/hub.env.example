# The one place for everything that depends on the server (deploy/README.md, step 5). Copy it to deploy/hub.env
# (Compose) or /etc/copperflow/hub.env (systemd), owned by root, mode 644, and fill in every empty value.
#
# Secrets: none. The hub makes its ticket key itself, in the data directory (ticket-key.pem, mode 600), on first
# start; nothing here is a password, key or token, and nothing secret may be added here (the hub reads no
# environment variable of its own: every value below reaches it as a command-line option).
#
# Plain KEY=value lines only: no quotes, no spaces around =, no "export" (Compose and systemd read the same file).

# The public host: the hub's pages, /mcp and the OAuth endpoints are served on https://<this>/ (--public-origin).
CF_PUBLIC_HOST=copperflow.kurpeeren.com

# The workspace domain (--workspace-domain): project <id> is served on https://<id>.<this>/. Needs a wildcard DNS
# record (*.<this>). Recommended: a subdomain of a registrable domain other than the public host's (README, step 1).
CF_WORKSPACE_DOMAIN=

# The data directory (--data): an absolute path with no comma, quote or newline, on a filesystem of its own (not /,
# not /var/lib/docker). The systemd unit's ReadWritePaths= names this same path and must be changed with it.
CF_DATA_DIR=/var/lib/copperflow

# The port the hub listens on, on 127.0.0.1 only (--port, with --bind 127.0.0.1 in both arrangements). The proxy is
# the only client; --trust-proxy is 127.0.0.1 in both arrangements, since the proxy reaches the hub on loopback.
CF_HUB_PORT=8780

# New certificates for project names the proxy may be told to get per week, all users together (--tls-ask-weekly).
# On-demand certificates cost one certificate per new project name, and a certificate authority limits new
# certificates per registered domain per week (Let's Encrypt: about 50); one user may have 5 new names a week. This
# suits a small closed beta. Anything larger needs a wildcard certificate for the workspace domain (DNS challenge; these
# files do not set one up); then the proxy never asks, and 0 turns project names off here. Keep it below the authority's limit.
CF_TLS_ASK_WEEKLY=40

# The hub's own user and group ids on the host (id -u copperflow-hub; id -g copperflow-hub). Compose only: the
# container runs as these, so it owns the data directory as the host sees it. Never 0, never 10001.
CF_HUB_UID=
CF_HUB_GID=

# The workspace group's gid (getent group copperflow-ws): --workspace-group, shared by the hub and its workspaces.
CF_WORKSPACE_GID=

# The gid of the group that owns the engine's socket (stat -c %g /var/run/docker.sock). Compose only: the hub
# container joins it to drive the host's engine (root-equivalent on the host; README, "What the Docker socket means").
CF_DOCKER_GID=

# The images, by name and tag (README, step 4). The workspace image is --workspace-image; tag every build anew so a
# rollback is the previous tag.
CF_WORKSPACE_IMAGE=copperflow-workspace:1
CF_HUB_IMAGE=copperflow-hub:1

# The hub container's name (--hub-container, with --workspace-reach network). Compose only.
CF_HUB_CONTAINER=copperflow-hub

# The hub container's limits (Compose only). Workspaces have their own limits, set by the runner.
CF_HUB_MEMORY=1g
CF_HUB_CPUS=1

# Compose only: the small network the proxy's ports arrive on, and the hub container's fixed address in it. Caddy
# listens on that address only, never on the workspace networks the hub container joins. Pick a subnet unused on
# the server (ip route shows the ones in use). IPv4 only: publish NO AAAA record for the public host or the workspace
# domain. IPv6 clients would reach Caddy through docker-proxy from one address, so the hub would count all of them as
# one client (README, "IPv6").
CF_EDGE_SUBNET=172.31.250.0/29
CF_HUB_EDGE_IP=172.31.250.2

# The Caddy image, pinned by digest like the bases (caddy:2@sha256:<digest>, the digest read as in README step 4).
# Compose only; Compose refuses to start while it is empty.
CF_CADDY_IMAGE=

# Caddy on the host (systemd arrangement): the address it listens on. Compose sets it to CF_HUB_EDGE_IP itself.
# 0.0.0.0 is IPv4 only; IPv6 needs "0.0.0.0 [::]" and the steps in README, "IPv6" (not verified).
CF_PROXY_BIND=0.0.0.0
