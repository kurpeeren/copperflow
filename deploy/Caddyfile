# Caddy in front of the hub (deploy/README.md). Used by both arrangements: in Compose it runs in the hub's network
# namespace; on the host (systemd) it runs beside the hub. Either way it reaches the hub on 127.0.0.1, which is what
# the hub's /_tls-ask requires. Values come from the environment ({$NAME}, defined in deploy/hub.env.example).
#
# What it does: TLS for the public host and, on demand, for each project host under the workspace domain (each
# certificate is issued only when the hub's /_tls-ask says the name exists); HTTP to HTTPS redirect (Caddy's
# automatic HTTPS redirects port 80 for every site below); Host forwarded unchanged; X-Forwarded-For set to the
# client's address only; event streams flushed at once; bodies up to 210 MB (the upload cap is 200 MB). Security
# headers are the hub's own and are not added here.
#
# Not here: a per-client connection cap. Caddy has none built in (the hub's own cap is off for the trusted proxy), so
# the firewall caps connections per client (README, step 6).

{
	# No admin endpoint: the configuration changes only by restarting Caddy.
	admin off
	default_bind {$CF_PROXY_BIND}
	on_demand_tls {
		ask http://127.0.0.1:{$CF_HUB_PORT}/_tls-ask
	}
}

https://{$CF_PUBLIC_HOST}, https://*.{$CF_WORKSPACE_DOMAIN} {
	tls {
		on_demand
	}

	# The certificate check is for Caddy alone. Proxied, it would arrive from loopback and be answered.
	@tlsask path /_tls-ask*
	respond @tlsask 404

	request_body {
		max_size 210MB
	}

	reverse_proxy 127.0.0.1:{$CF_HUB_PORT} {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		# Event streams (the Studio's and MCP's) are passed on as they come.
		flush_interval -1
		transport http {
			# An open stream lives up to 12 hours.
			read_timeout 13h
			write_timeout 13h
		}
	}
}
