# nginx in front of the hub, on the host beside it (deploy/README.md, arrangement B with nginx). The ${CF_...} names
# are filled from deploy/hub.env.example's values by envsubst with an explicit list, so nginx's own $variables stay:
#
#   set -a; . /etc/copperflow/hub.env; set +a
#   envsubst '${CF_PUBLIC_HOST} ${CF_WORKSPACE_DOMAIN} ${CF_HUB_PORT}' < deploy/nginx.conf.example > /etc/nginx/conf.d/copperflow.conf
#   nginx -t && systemctl reload nginx
#
# Certificates: nginx cannot issue them on demand, so the workspace domain needs a WILDCARD certificate, which only the
# DNS challenge can obtain. With certbot and the DNS plugin for the domain's DNS provider, for example:
#
#   certbot certonly --dns-<provider> --dns-<provider>-credentials /root/.secrets/dns.ini \
#     -d '<CF_WORKSPACE_DOMAIN>' -d '*.<CF_WORKSPACE_DOMAIN>'
#   certbot certonly --webroot -w /var/www/letsencrypt -d '<CF_PUBLIC_HOST>'
#
# The DNS credentials file is a secret: root-owned, mode 600, never in the repository or in hub.env.
#
# Security headers are the hub's own and are not added here; that includes Strict-Transport-Security, which the hub
# sends on every answer of an https public origin. The hub's /_tls-ask is not used with nginx and is refused below
# (the hub also refuses any forwarded one).
#
# IPv4 only as written: publish no AAAA records. For IPv6, each server needs a second listen line for [::] with the
# same port (README, "IPv6"; not verified).

# One connection-count table for every client address (the hub's own per-address cap is off for its trusted proxy).
limit_conn_zone $binary_remote_addr zone=perclient:10m;

upstream copperflow_hub {
    server 127.0.0.1:${CF_HUB_PORT};
    keepalive 16;
}

# HTTP to HTTPS, for the public host and every project host (and the certbot webroot for the public host).
server {
    listen 80;
    server_name ${CF_PUBLIC_HOST} *.${CF_WORKSPACE_DOMAIN};
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# The public host. The project hosts' server below repeats the same proxy settings.
server {
    listen 443 ssl;
    http2 on;
    server_name ${CF_PUBLIC_HOST};
    ssl_certificate /etc/letsencrypt/live/${CF_PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CF_PUBLIC_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    limit_conn perclient 64;
    # Above the hub's 200 MB upload cap; the hub enforces its own limits.
    client_max_body_size 210m;
    client_body_timeout 60s;

    location = /_tls-ask {
        return 404;
    }

    location / {
        proxy_pass http://copperflow_hub;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Host unchanged: the hub tells the public origin and each project origin apart by it.
        proxy_set_header Host $host;
        # The client's address only, never appended to a value the client sent.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        # An open event stream lives up to 12 hours; an upload up to 2 hours.
        proxy_read_timeout 13h;
        proxy_send_timeout 2h;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name *.${CF_WORKSPACE_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${CF_WORKSPACE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CF_WORKSPACE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    limit_conn perclient 64;
    client_max_body_size 210m;
    client_body_timeout 60s;

    location = /_tls-ask {
        return 404;
    }

    location / {
        proxy_pass http://copperflow_hub;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 13h;
        proxy_send_timeout 2h;
    }
}
