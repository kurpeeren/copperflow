[Unit]
Description=Update the copperflow site's pages from the public repository
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=copperflow-site
ExecStart=/opt/copperflow-site/update.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/copperflow-site/repo /opt/copperflow-site/public /opt/copperflow-site/state
