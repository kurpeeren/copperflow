{
  "name": "copperflow",
  "version": "0.3.0",
  "description": "Design circuits in code with a human and an AI agent editing the same files.",
  "license": "Apache-2.0",
  "author": "Eren Kürpe",
  "repository": {
    "type": "git",
    "url": "https://github.com/kurpeeren/copperflow.git"
  },
  "keywords": [
    "pcb",
    "schematic",
    "circuit",
    "tscircuit",
    "mcp",
    "eda"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "copperflow": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/core/index.js"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config studio/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p studio/tsconfig.json",
    "test": "vitest run",
    "test:perf": "vitest run --mode perf --no-file-parallelism --silent=false",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@babel/parser": "8.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.28.2",
    "magic-string": "1.4.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/types": "8.1.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
